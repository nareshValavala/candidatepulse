# --- secrets (NEVER commit) ---
.env
**/.env
*.local

# --- dependencies ---
node_modules/
**/node_modules/

# --- local database (sqlite) ---
data/
**/data/

# --- generated eval fixtures (seed.json is committed; generated sets are reproducible) ---
**/evals/fixtures/generated-*.json

# --- docs / strategy (kept OUT of the repo) ---
*.md
**/*.md
!README.md

# --- build / logs ---
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.swp
