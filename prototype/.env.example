# Copy this file to ".env" (same folder) and paste your real key below.
#   PowerShell:  Copy-Item .env.example .env
# Then edit .env and replace the placeholder. Restart the server after editing.

ANTHROPIC_API_KEY=

# Optional — pick the model (default is claude-sonnet-4-6 if omitted):
#   claude-haiku-4-5   cheapest (~1,200 analyses per $5)
#   claude-sonnet-4-6  default  (~200 analyses per $5)
#   claude-opus-4-8    max quality
# MODEL=claude-haiku-4-5

# Optional — change the port (default 5173):
# PORT=5173
